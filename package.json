{
  "name": "ps-ai",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "description": "PS-AI — Photoshop local Qwen-Image 2.1 editing panel",
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=15000 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "p0": "node --import tsx scripts/p0-live.ts",
    "gateway": "node --import tsx server/main.ts",
    "brand:export": "node scripts/export-brand.mjs",
    "brand:check": "node scripts/export-brand.mjs --check",
    "package": "npm run test && npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "pako": "1.0.11",
    "upng-js": "2.1.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.10.0",
    "@types/upng-js": "2.1.5",
    "esbuild": "0.25.11",
    "fflate": "0.8.3",
    "linkedom": "0.18.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "license": "GPL-3.0-only"
}
