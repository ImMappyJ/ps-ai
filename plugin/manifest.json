{
  "manifestVersion": 5,
  "id": "local.ps-ai",
  "name": "PS-AI",
  "version": "0.6.1",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "27.0.0",
      "data": {
        "apiVersion": 2
      }
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "psai",
      "label": {
        "default": "PS-AI"
      },
      "minimumSize": {
        "width": 300,
        "height": 420
      },
      "maximumSize": {
        "width": 1600,
        "height": 2200
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 700
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 760
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-on-dark.png",
          "scale": [
            1,
            2
          ],
          "theme": ["darkest", "dark", "medium"],
          "species": [
            "chrome"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-on-light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"],
          "species": ["chrome"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "request",
    "clipboard": "readAndWrite",
    "launchProcess": {"extensions": [".cmd"]}
  }
}
